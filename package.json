{
  "name": "pickle-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "push:keys": "node scripts/generate-vapid.mjs",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build && node scripts/build-server.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "preview:rivalry": "node --import tsx tests/browser/rivalry-preview.ts",
    "opponent-server": "node --env-file-if-exists=.env.local server/opponent.mjs",
    "start": "node server/production.mjs",
    "evaluate:games": "node --import tsx scripts/evaluate-games.ts",
    "evaluate:skills": "node --import tsx scripts/evaluate-skills.ts",
    "evaluate:net-skills": "node --import tsx scripts/evaluate-net-skills.ts",
    "evaluate:soft-skills": "node --import tsx scripts/evaluate-soft-skills.ts",
    "evaluate:finishing": "node --import tsx scripts/evaluate-finishing.ts",
    "rebuild:strategies": "node --env-file-if-exists=.env.local --import tsx scripts/rebuild-strategies.ts",
    "rebuild:rivalries": "node --env-file-if-exists=.env.local --import tsx scripts/rebuild-rivalries.ts",
    "backfill:shot-selections": "node --env-file-if-exists=.env.local --import tsx scripts/backfill-shot-selections.ts",
    "multiplayer-server": "node --env-file-if-exists=.env.local --import tsx server/multiplayer/entry.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "three": "^0.180.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/three": "^0.180.0",
    "@types/web-push": "^3.6.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "pg": "^8.23.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "^0.35.4",
      "onnxruntime-node": {
        "adm-zip": "^0.6.1"
      }
    }
  }
}
