# Keep API credentials server-side. Never prefix this key with VITE_.
OPPONENT_PROVIDER=api
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Remote multiplayer: server authority; disabled by default.
# Existing browser auth credentials (same Supabase project as the server).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional main-menu link. Direct tester URL: /?multiplayer=1
VITE_MULTIPLAYER_ENABLED=false
# Server only. NEVER put the service role credential in a VITE_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MULTIPLAYER_ENABLED=false
# Disable creation independently while preserving existing matches and turns.
MULTIPLAYER_CREATE_ENABLED=false
# Comma-separated auth user UUIDs for two known, recoverable tester accounts.
MULTIPLAYER_TESTER_IDS=
# Local standalone API port, proxied by Vite.
MULTIPLAYER_PORT=5175

# Turn notifications (Railway runtime variables; NEVER use VITE_ prefixes).
# Generate once: npm run push:keys -- /absolute/private/path/picklebash-vapid.env
# Keep the same keys across deployments. Set a real contact address as subject.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-ops-address@example.com
