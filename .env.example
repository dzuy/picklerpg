# Keep API credentials server-side. Never prefix this key with VITE_.
OPPONENT_PROVIDER=api
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Remote multiplayer: server authority; disabled by default.
# Existing browser auth credentials (same Supabase project as the server).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional main-menu link. Direct tester URL: /?multiplayer=1
VITE_MULTIPLAYER_ENABLED=false
# Server only. NEVER put the service role credential in a VITE_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MULTIPLAYER_ENABLED=false
# Disable creation independently while preserving existing matches and turns.
MULTIPLAYER_CREATE_ENABLED=false
# Comma-separated auth user UUIDs for two known, recoverable tester accounts.
MULTIPLAYER_TESTER_IDS=
# Local standalone API port, proxied by Vite.
MULTIPLAYER_PORT=5175

# Turn notifications (Railway runtime variables; NEVER use VITE_ prefixes).
# Generate once: npm run push:keys -- /absolute/private/path/picklebash-vapid.env
# Keep the same keys across deployments. Set a real contact address as subject.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-ops-address@example.com

# Temporary manual testing: immediate, unlimited nudges. Keep false for normal limits.
NUDGE_TEST_UNLIMITED=false

# Native iOS APNs (Railway/server only; no VITE_ prefix).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.picklebash.app
# Contents of Apple's .p8 key, multiline or with literal \n escapes. Secret manager only.
APNS_PRIVATE_KEY=

# Product analytics. Keys below are public ingestion tokens, never personal/secret API keys.
# Local development never sends events; staging must use a separate PostHog project/token.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_ENABLED=false
VITE_ANALYTICS_ENVIRONMENT=development
VITE_APP_VERSION=0.1.0
VITE_POSTHOG_REPLAY_ENABLED=false
VITE_ANALYTICS_DEBUG=false
# Local dev only; ignored in production. Example: {"rematch_auto_countdown":true}
VITE_FEATURE_FLAG_OVERRIDES={}
# Server runtime (Railway): set production/staging and explicitly enable after migration.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENABLED=false
ANALYTICS_ENVIRONMENT=development
APP_VERSION=0.1.0
# ISO timestamp at rollout. Required to export existing committed domain facts.
POSTHOG_EXPORT_SINCE=
